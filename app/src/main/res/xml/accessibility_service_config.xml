<?xml version="1.0" encoding="utf-8"?>
<!--
  feedbackHaptic (not feedbackGeneric): KeyMapper found that feedbackGeneric breaks the OK key
  on Android TV (KeyMapper issue #2210). The other flags match KeyMapper.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackHaptic"
    android:accessibilityFlags="flagDefault|flagIncludeNotImportantViews|flagReportViewIds|flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="200"
    android:settingsActivity="app.dpadmouse.MainActivity" />
